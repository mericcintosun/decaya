# Decaya needs no environment variables.
# All measurement and audio processing runs in the visitor's browser via the Web Audio API,
# and rooms you measure are stored in that browser's localStorage.
# The room store (lib/store.ts) needs no secret and no NEXT_PUBLIC_ key.
#
# NEXT_PUBLIC_BRAND_FILES is set automatically by next.config.ts at build time
# (it lists uploaded images in public/brand). Do not set it by hand.
# NEXT_PUBLIC_BRAND_FILES=

# Which side of the seam runs (read only in lib/adapter.ts). Any other value, or unset, means fake.
# real = live in-browser measurement engine (needs no secret), fake = fixture measurement and seeded fieldbook
ADAPTER_MODE=fake
